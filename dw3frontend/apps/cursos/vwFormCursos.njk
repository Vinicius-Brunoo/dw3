{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulario de cursos</h1>
    <p class="text-secondary mb-0">Manipule os dados cadastrais dos cursos.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Dados do curso</h2>
          <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover um curso.</p>
        </div>
      </div>

      <form id="frmCursos" data-servidor-dw3="{{ servidorDw3 }}" data-oper="{{ oper }}" data-cursoid="{{ cursoid }}">
        <input type="hidden" id="cursoid" name="cursoid" value="{{ cursoid }}">
        <input type="hidden" id="deleted" name="deleted" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-4">
            <label for="codigo" class="form-label">Codigo</label>
            <input type="text" class="form-control" id="codigo" name="codigo" value="" required>
          </div>

          <div class="col-12 col-md-8">
            <label for="descricao" class="form-label">Descricao</label>
            <input type="text" class="form-control" id="descricao" name="descricao" value="" required>
          </div>

          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="ativo" name="ativo" checked>
              <label class="form-check-label" for="ativo">Ativo</label>
            </div>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary" id="btnInserirCurso">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning" id="btnAtualizarCurso">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger" id="btnRemoverCurso">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/cursos" id="btnFecharCurso">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/cursos/vwFormCursos.js"></script>
{% endblock %}
