{% extends "layout.njk" %}
{% block content %}
  <section class="login-layout">
    <div class="login-story">
      <a class="brand" href="/login"><span class="brand-mark"><i class="bi bi-flower1" aria-hidden="true"></i></span><span>Pastejo<small>GESTÃO RURAL</small></span></a>
      <div class="login-story-content">
        <span class="eyebrow">DA PORTEIRA AO PIQUETE</span>
        <h1>Cada animal<br>no lugar certo.</h1>
        <p>Organize suas áreas, acompanhe os animais e simplifique o manejo da sua propriedade.</p>
        <div class="field-illustration" aria-hidden="true"><div><i class="bi bi-flower1"></i></div><div></div><div></div><div><i class="bi bi-flower1"></i></div></div>
      </div>
      <span class="login-story-footer">Mais organização para o dia a dia no campo.</span>
    </div>
    <div class="login-form-panel">
      <div class="login-form-content">
        <span class="login-symbol"><i class="bi bi-door-open" aria-hidden="true"></i></span>
        <p class="eyebrow">BEM-VINDO AO PASTEJO</p>
        <h2>Acesse sua conta</h2>
        <p class="page-description">Entre para cuidar do que acontece no campo.</p>
        <form id="loginForm" data-servidor-dw3="{{ servidorDw3 }}">
          <div id="loginError" class="alert alert-danger d-none" role="alert"></div>
          <div class="mb-4"><label class="form-label" for="usuario">Usuário</label><input class="form-control" id="usuario" name="usuario" type="text" placeholder="Digite seu usuário" autocomplete="username" required></div>
          <div class="mb-4"><label class="form-label" for="senha">Senha</label><input class="form-control" id="senha" name="senha" type="password" placeholder="Digite sua senha" autocomplete="current-password" required></div>
          <button class="btn btn-primary w-100" type="submit">Entrar no sistema <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
        </form>
        <p class="login-note"><i class="bi bi-shield-check" aria-hidden="true"></i> Seu espaço para organizar o pastejo.</p>
      </div>
    </div>
  </section>
  <script src="/js/dw3frontend.js"></script>
  <script src="/js/login/vwLogin.js"></script>
{% endblock %}
