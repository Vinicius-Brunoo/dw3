{% extends "layout.njk" %}
{% block content %}
  <a class="back-link" href="/pastos"><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar para pastos</a>
  <header class="page-heading form-heading"><div><p class="eyebrow">PASTOS</p><h1>{% if oper == 'Up' %}Editar pasto{% elif oper == 'De' %}Remover pasto{% elif oper == 'Re' %}Detalhes do pasto{% else %}Novo pasto{% endif %}</h1><p class="page-description">Defina um nome e a área total deste pasto.</p></div></header>
  <section class="panel form-panel"><div class="panel-heading"><div><h2>Dados do pasto</h2><p>Preencha os campos abaixo para continuar.</p></div><span class="section-icon"><i class="bi bi-map" aria-hidden="true"></i></span></div>
    <form id="frmPastos" class="record-form" data-servidor-dw3="{{ servidorDw3 }}" data-oper="{{ oper }}" data-pastoid="{{ pastoid }}">
      <input type="hidden" id="pastoid" name="pastoid" value="{{ pastoid }}">
      <input type="hidden" id="removido" name="removido" value="false">
      {% if oper == 'De' %}<div class="alert alert-warning" role="alert">Confira os dados antes de confirmar a remoção deste registro.</div>{% endif %}
        <div class="row g-4">
          <div class="col-12 col-md-6"><label for="descricao" class="form-label">Descrição</label>
            <input class="form-control" id="descricao" placeholder="Ex.: Pasto norte" type="text" maxlength="120" required>
          </div>
          <div class="col-12 col-md-6"><label for="areatotal" class="form-label">Área total (ha)</label>
            <input class="form-control" id="areatotal" placeholder="Ex.: 12,5" type="number" step="any" min="0.0001" required>
          </div>
        </div>

      <div class="form-actions">
        {% if oper == 'Cr' %}<button type="button" class="btn btn-primary" id="btnInserirPasto"><i class="bi bi-check2" aria-hidden="true"></i> Salvar pasto</button>{% endif %}
        {% if oper == 'Up' %}<button type="button" class="btn btn-primary" id="btnAtualizarPasto"><i class="bi bi-check2" aria-hidden="true"></i> Salvar alterações</button>{% endif %}
        {% if oper == 'De' %}<button type="button" class="btn btn-danger" id="btnRemoverPasto"><i class="bi bi-trash" aria-hidden="true"></i> Confirmar remoção</button>{% endif %}
        <a class="btn btn-outline-secondary" href="/pastos" id="btnFecharPasto">{% if oper == 'Re' %}Voltar{% else %}Cancelar{% endif %}</a>
      </div>
    </form>
  </section>
  <script src="/js/dw3frontend.js"></script>
  <script src="/js/pastos/vwFormPastos.js"></script>
{% endblock %}
